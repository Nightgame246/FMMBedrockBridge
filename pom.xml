<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.crazypandas</groupId>
    <artifactId>FMMBedrockBridge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>FMMBedrockBridge</name>
    <description>Bridge between FreeMinecraftModels and Geyser/Bedrock for custom model display</description>

    <properties>
        <!-- Bytecode target raised 21 -> 25 on 2026-09-09. Every live instance runs
             Temurin 25 since 2026-08-16; the only Java 21 holdout (dungeons01) is an
             empty shell with no server jar and no process. Compiling has required a
             JDK >= 25 all along anyway: Paper's 26.2 API ships class file version 69
             and javac 21 cannot read it.
             NOTE: the jar no longer loads on a Java 21 server. If one ever comes back,
             drop this to 21 again — the sources stay Java 21 compatible. -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>

        <!-- Primary compile target: Minecraft 26.2 ("Chaos Cubed", Mojang's new
             year-based versioning; there is no 1.22). Paper's API artifact moved
             from "<mc>-R0.1-SNAPSHOT" to "<mc>.build.<n>-<channel>" releases.

             The plugin must ALSO keep running on 1.21.x, which is what the servers
             still run. That is not something the primary build can prove, so the
             `legacy-1.21` profile recompiles the exact same sources against the old
             API. Both must pass — see verify-both-apis.sh. Only API present in BOTH
             may be used; anything 26.2-only needs a reflective guard. -->
        <paper.api.version>26.2.build.87-stable</paper.api.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>magmaguy-repo</id>
            <url>https://repo.magmaguy.com/releases</url>
        </repository>
        <repository>
            <id>opencollab</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
        <repository>
            <id>codemc-snapshots</id>
            <url>https://repo.codemc.io/repository/maven-snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- FreeMinecraftModels -->
        <dependency>
            <groupId>com.magmaguy</groupId>
            <artifactId>FreeMinecraftModels</artifactId>
            <version>2.11.1</version>
            <scope>provided</scope>
            <exclusions>
                <!-- These are shaded into the FMM jar at build time but still
                     listed as compile deps in the published pom. Excluding them
                     prevents Maven from trying to resolve unavailable artifacts. -->
                <exclusion>
                    <groupId>com.magmaguy</groupId>
                    <artifactId>MagmaCore</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.magmaguy</groupId>
                    <artifactId>ResourcePackManager</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.magmaguy</groupId>
                    <artifactId>EliteMobs</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.MilkBowl</groupId>
                    <artifactId>VaultAPI</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.projectlombok</groupId>
                    <artifactId>lombok</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.spigotmc</groupId>
                    <artifactId>spigot-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.geysermc.floodgate</groupId>
                    <artifactId>api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.geysermc.geyser</groupId>
                    <artifactId>api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bstats</groupId>
                    <artifactId>bstats-bukkit</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-io</groupId>
                    <artifactId>commons-io</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.code.gson</groupId>
                    <artifactId>gson</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- EliteMobs (soft-dep). Imported in EliteMobsHook (api.* + mobconstructor),
             BedrockCombatTrigger (api.* combat events) and AdvancedCombatHook.
             AdvancedCombatHook is the ONLY class allowed to name the internal, [Alpha]
             package com.magmaguy.elitemobs.advancedcombat — keep it that way. -->
        <dependency>
            <groupId>com.magmaguy</groupId>
            <artifactId>EliteMobs</artifactId>
            <version>10.9.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Floodgate API -->
        <dependency>
            <groupId>org.geysermc.floodgate</groupId>
            <artifactId>api</artifactId>
            <version>2.2.5-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Gson (provided by Paper) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- PacketEvents — 2.13.0 is the first release with Minecraft 26.2 support.
             Still ships the older protocol versions, so it stays usable on 1.21.x.
             NOTE: the server must run >= 2.13.0 too before moving to 26.2; the
             deployed build is 2.12.1 (see HANDOFF). -->
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.13.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 (test only) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Recompiles the same sources against the last 1.21.x API. Guards against
             using 26.2-only API in code that still has to run on the live 1.21.x
             servers. Run via: mvn -Plegacy-1.21 clean test -->
        <profile>
            <id>legacy-1.21</id>
            <properties>
                <paper.api.version>1.21.10-R0.1-SNAPSHOT</paper.api.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <finalName>${project.name}-${project.version}-${maven.build.timestamp}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
